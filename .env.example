# Base PostgreSQL (Neon, région Europe). Voir DEPLOIEMENT.md.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"

# Identifiants Partenaires Amazon (facultatifs), un par boutique.
# Les liens Amazon des listes les portent automatiquement à l'affichage.
# AMAZON_TAG_FR="quioffre-21"
# AMAZON_TAG_DE="..."

# Rappels par e-mail (Resend). Sans clé, aucun e-mail ne part.
# RESEND_API_KEY="re_..."
# EMAIL_EXPEDITEUR="Qui Offre <rappels@quioffre.fr>"
# Secret de la tâche planifiée quotidienne (Vercel l'envoie dans Authorization).
# CRON_SECRET="une-longue-chaine-aleatoire"
